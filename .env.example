# =============================================================================
# Sutra configuration
# =============================================================================
# Copy this file to .env only when you need to override defaults:
#
#   cp .env.example .env
#
# The Docker Compose stack works without a .env file. Values here are local
# defaults, not production secrets. For any deployment reachable by other
# people, set a strong POSTGRES_PASSWORD and MinIO credentials, and put the app
# behind TLS (a reverse proxy such as Caddy, nginx or Traefik).
# =============================================================================

# -----------------------------------------------------------------------------
# Host ports / Compose
# -----------------------------------------------------------------------------
# Frontend UI: http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=3000

# Direct API access is bound to 127.0.0.1 only. The UI reaches the API through
# the nginx same-origin proxy, so this port is for local curl/debugging.
API_PORT=8080

# Only used by docker-compose.dev.yml (loopback-only port publishing).
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional artifact-store profile. By default MinIO is not started. Upstream
# MinIO community images are no longer freely published; set MINIO_IMAGE to a
# maintained S3-compatible image or point MINIO_ENDPOINT at an external store.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z

# PostgreSQL (internal to the Compose network)

# The default password is deliberately local-only. The database has no host
# port in the default stack.
POSTGRES_USER=searcher
POSTGRES_PASSWORD=searcher
POSTGRES_DB=searcher

# Override the full connection string only when using an external PostgreSQL
# with pgvector. When set, this takes precedence over POSTGRES_* above.
# DATABASE_URL=postgresql://searcher:searcher@db:5432/searcher

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
YTDLP_BINARY=/usr/local/bin/yt-dlp
YTDLP_TIMEOUT_SECONDS=120
TRANSCRIPT_MAX_UPLOAD_MB=20
TRANSCRIPT_MAX_CONCURRENT_INGESTIONS=2

# -----------------------------------------------------------------------------
# Embedding model
# -----------------------------------------------------------------------------
# The upstream revision is pinned in deploy/model-init/model-manifest.json.
# MODEL_REVISION is an optional guard: if set, it must match the manifest.
MODEL_REVISION=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=v1.5
EMBEDDING_ONNX_PATH=/models/bge-small-en-v1.5/model.onnx
EMBEDDING_TOKENIZER_PATH=/models/bge-small-en-v1.5/tokenizer.json
ONNXRUNTIME_SHARED_LIBRARY_PATH=/opt/onnxruntime/lib/libonnxruntime.so
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TOKENS=512
EMBEDDING_ONNX_THREADS=4
EMBEDDING_TIMEOUT=5m

# -----------------------------------------------------------------------------
# Processing queue / retrieval
# -----------------------------------------------------------------------------
PROCESSING_WORKERS=2
SHUTDOWN_TIMEOUT_SECONDS=15
SEARCH_CANDIDATE_POOL=100
SEARCH_RRF_K=60
SEARCH_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Optional artifact store (S3-compatible)
# -----------------------------------------------------------------------------
# Structured transcript cues always live in PostgreSQL. Enable this only to
# retain the original uploaded/downloaded subtitle files as objects.
ARTIFACT_STORE_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=sutra
MINIO_SECRET_KEY=sutra-local-only-change-me
MINIO_BUCKET=sutra-artifacts
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Credentials for the optional bundled MinIO service (profile "artifacts").
MINIO_ROOT_USER=sutra
MINIO_ROOT_PASSWORD=sutra-local-only-change-me
