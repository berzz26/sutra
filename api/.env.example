# Copy to .env (or export these) when running the backend directly.
# The main config surface lives in environment variables; see docs/architecture.md.

# Required
DATABASE_URL=postgresql://host:pass@localhost:5432/searcher

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=18080
LOG_LEVEL=info

# Artifact store (optional; set ARTIFACT_STORE_ENABLED=true to require it)
ARTIFACT_STORE_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_key
MINIO_SECRET_KEY=minio_pass
MINIO_BUCKET=bucket_name
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Transcript ingestion
YTDLP_BINARY=yt-dlp
YTDLP_TIMEOUT_SECONDS=120
TRANSCRIPT_MAX_UPLOAD_MB=20
TRANSCRIPT_MAX_CONCURRENT_INGESTIONS=2

# Local transcript embedding and processing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=v1.5
EMBEDDING_ONNX_PATH=embedding/models/bge-small-en-v1.5/model.onnx
EMBEDDING_TOKENIZER_PATH=embedding/models/bge-small-en-v1.5/tokenizer.json
ONNXRUNTIME_SHARED_LIBRARY_PATH=third_party/onnxruntime/onnxruntime-linux-x64-1.31.1/lib/libonnxruntime.so
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TOKENS=512
EMBEDDING_ONNX_THREADS=4
EMBEDDING_TIMEOUT=5m
PROCESSING_WORKERS=2
SHUTDOWN_TIMEOUT_SECONDS=15

# Hybrid retrieval
SEARCH_CANDIDATE_POOL=100
SEARCH_RRF_K=60
SEARCH_TIMEOUT=10s
